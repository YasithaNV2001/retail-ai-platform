# Copy to .env and fill in. Never commit .env.
RAP_ENV=dev
RAP_CATALOG=rap_dev
RAP_SCHEMA_PREFIX=
# GitHub data repo (rap-data)
RAP_DATA_WRITE_TOKEN=
RAP_DATA_READ_TOKEN=
# Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Neon
RAP_NEON_FEATURES_URL=
RAP_NEON_COPILOT_URL=
# Qdrant
RAP_QDRANT_URL=
RAP_QDRANT_API_KEY=
# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Hugging Face
HF_TOKEN=
# Shared between services
RAP_FORECAST_API_KEY=
RAP_COPILOT_WEBHOOK_SECRET=
RAP_DEMO_ACCESS_CODE=
# Service URLs (filled after deployment)
RAP_FORECAST_API_URL=
RAP_COPILOT_API_URL=
RAP_ALLOWED_ORIGINS=
# Render deploy hooks (GitHub secrets, added later)
RENDER_DEPLOY_HOOK_P2=
RENDER_DEPLOY_HOOK_P3=
